# ============================================================
# ML Trading Business Ops — Environment Variables Template
# ============================================================
# Copy this file to .env.local for local dev.
# NEVER commit real values. NEVER put real values in this file.
# Production secrets live in Cloudflare Workers secrets and Pages env vars.
# ============================================================

# ---------- Core: required from Phase 1 ----------

# Neon PostgreSQL connection string (pooled endpoint)
# Get it from: Neon dashboard → your project → Connect → Pooled connection
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# JWT signing keys — generate with: openssl rand -base64 32
# Two separate keys: one for access tokens, one for refresh tokens
JWT_SIGNING_KEY=replace_me_with_random_32_byte_base64_string
JWT_REFRESH_KEY=replace_me_with_a_different_random_32_byte_base64_string

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8787

# Node environment
NODE_ENV=development


# ---------- Email: required from Phase 1 (password reset) ----------

# Resend API key — sign up free at https://resend.com
# Alternative: SendGrid, Postmark, AWS SES
RESEND_API_KEY=re_replace_me
EMAIL_FROM=noreply@mltradingops.com


# ---------- File storage: required from Phase 3 ----------

# Cloudflare R2 credentials
# Get from: Cloudflare dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mlt-ops-uploads
R2_PUBLIC_URL=


# ---------- Warehouse printing: Phase 6 (optional) ----------

# PrintNode API key — leave blank to disable printing feature
# Get from: https://printnode.com
PRINTNODE_API_KEY=


# ---------- Payment gateway: Phase 9 (optional) ----------

# Stripe — leave blank to disable card payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=


# ---------- Accounting: Phase 9 (optional) ----------

# QuickBooks Online — leave blank to disable QBO sync
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
QBO_REFRESH_TOKEN=
QBO_REALM_ID=


# ---------- Error tracking: Phase 10 (optional) ----------

# Sentry — leave blank to disable
SENTRY_DSN=


# ---------- Rate limiting: optional ----------

# Upstash Redis for rate limiting — free tier
# Alternative: Cloudflare Workers KV
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
